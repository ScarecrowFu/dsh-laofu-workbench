# Examples only: the launcher does not automatically load .env.
# Export the variables you need in the shell before starting the workbench.
# Model and media API keys are configured through the workbench UI.

# LWB_PRODUCT_HOME=./lwb/local/current

# Optional: place the local DSH runtime state outside the repository.
# LWB_DSH_HOME=./lwb/local/current/dsh-home

# Optional: move the local pack registry as well when isolating an instance.
# LWB_PACK_REGISTRY=./lwb/local/current/packs.json

# Optional: override the durable capability-pack workspace root for both carriers.
# This is independent of the Web/Desktop plugin activation profile.
# LWB_PACK_STATE_DIR=./lwb/local/current/pack-state

# Optional: use a Bailian workspace-specific API base for both voice cloning and synthesis.
# The default is https://dashscope.aliyuncs.com/api/v1, which Bailian has put into
# maintenance mode; the workspace-specific domain is recommended for production.
# LWB_SPOKEN_VIDEO_BAILIAN_BASE_URL=https://<workspace-id>.cn-beijing.maas.aliyuncs.com/api/v1

# Optional: override the Bailian speech models. The defaults are the current
# date-suffix-free mainline models; dated snapshots are retired without notice.
# LWB_SPOKEN_VIDEO_BAILIAN_TTS_MODEL=qwen-audio-3.1-tts-plus
# LWB_SPOKEN_VIDEO_BAILIAN_VOICE_CLONE_MODEL=qwen-audio-3.1-tts-plus
# LWB_SPOKEN_VIDEO_BAILIAN_VOICE_ENROLLMENT_MODEL=voice-enrollment
# LWB_SPOKEN_VIDEO_BAILIAN_DEFAULT_VOICE=longanhuan_v3.1

# Optional: reuse a locally installed Chrome/Chromium for Remotion rendering.
# Export this in the launching shell (the launcher does not auto-load .env).
# LWB_REMOTION_BROWSER_EXECUTABLE=/absolute/path/to/chrome
