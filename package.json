{
  "name": "dsh-laofu-workbench",
  "version": "0.1.4",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Laofu Workbench product profile built on the pinned DeepSeek Harness composition.",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "node lwb/dsh-launcher.mjs",
    "start": "node lwb/dsh-launcher.mjs",
    "dev:desktop": "node lwb/desktop/dev.mjs",
    "start:desktop": "node lwb/desktop/dev.mjs --skip-build",
    "package:desktop": "node lwb/desktop/package.mjs",
    "package:desktop:dir": "node lwb/desktop/package.mjs --dir",
    "package:desktop:portable": "node lwb/desktop/package.mjs --unsigned --portable",
    "package:desktop:official": "node lwb/desktop/package.mjs --edition commercial",
    "package:desktop:unsigned": "node lwb/desktop/package.mjs --unsigned --portable",
    "package:plan": "node lwb/desktop/package.mjs --plan",
    "package:oneclick": "node scripts/package-desktop.mjs",
    "package:mac": "node scripts/package-desktop.mjs --host mac",
    "package:win": "node scripts/package-desktop.mjs --host win",
    "snapshot:product": "node scripts/pack-product-source.mjs",
    "setup": "node scripts/setup-upstream.mjs",
    "pack:list": "node lwb/pack-manager.mjs list",
    "pack:install": "node lwb/pack-manager.mjs install",
    "pack:remove": "node lwb/pack-manager.mjs remove",
    "arena:build": "node lwb/packs/ai-arena/build-model-art.mjs && node lwb/packs/ai-arena/build-werewolf-art.mjs && node lwb/packs/ai-arena/build-client.mjs && node lwb/packs/ai-arena/build-replay.mjs",
    "arena:test": "node --test lwb/packs/ai-arena/test/*.test.mjs",
    "check": "node scripts/check-syntax.mjs",
    "dsh:dump": "node lwb/dsh-launcher.mjs --dump-config",
    "profile:check": "node lwb/profile-smoke.mjs",
    "pack:profile-check": "node lwb/pack-profile-smoke.mjs",
    "test": "npm run check && npm run profile:check && npm run pack:profile-check && npm run unit:test && npm run arena:test",
    "upstream:check": "node lwb/upgrade/verify.mjs",
    "unit:test": "node --test lwb/pack-sdk/test/*.test.mjs lwb/desktop/*.test.mjs lwb/dsh-bundle/test/pack-*.test.mjs lwb/dsh-bundle/test/ats-client.test.mjs lwb/dsh-bundle/test/task-model.test.mjs lwb/dsh-bundle/test/lwb-model.test.mjs lwb/dsh-bundle/test/client-*.test.mjs lwb/dsh-bundle/test/runtime-config.test.mjs lwb/packs/spoken-video/test/*.test.mjs",
    "upstream:refs": "sh lwb/upgrade/check-upstream.sh",
    "test:integration": "node lwb/upgrade/smoke.mjs"
  },
  "packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af",
  "dependencies": {
    "@algorithm.ts/gomoku": "4.0.5",
    "@babel/parser": "7.24.1",
    "@remotion/bundler": "4.0.522",
    "@remotion/cli": "4.0.522",
    "@remotion/renderer": "4.0.522",
    "lucide-react": "0.468.0",
    "postcss": "8.5.28",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.522",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "esbuild": "0.28.1"
  }
}
